# Published store listing URLs. Leave empty to show "Coming soon" placeholders.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=

# Force demo mode on even when Supabase is configured (optional).
VITE_DEMO_MODE=

# Supabase (backend). When both are set, real auth/bookings/contact are used and demo mode turns off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
